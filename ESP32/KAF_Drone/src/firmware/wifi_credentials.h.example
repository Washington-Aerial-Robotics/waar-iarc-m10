//Lab WiFi router the drone joins at boot instead of hosting its own "KAF_Quadcopter_Drone" AP.
//Copy this file to wifi_credentials.h (same folder) and fill it in - wifi_credentials.h is gitignored so the
//password never reaches GitHub. Without wifi_credentials.h the drone boots as its own AP, as before.
//
//The ESP32 only supports 2.4 GHz - use the router's 2.4 GHz SSID (TP-Link: the name WITHOUT "_5G").
//Max 19 characters each for SSID and password (periph_wifi.cpp buffers).
#define WIFI_STA_SSID     "TP-Link_XXXX"
#define WIFI_STA_PASSWORD "password"

//Fixed IP so vicon_link.py/the browser always find the drone - pick an address OUTSIDE the router's DHCP
//pool (TP-Link default pool is .100-.199) and use a different one per drone (.240, .241, ...).
#define WIFI_STA_IP       192, 168, 0, 240
#define WIFI_STA_GATEWAY  192, 168, 0, 1
#define WIFI_STA_SUBNET   255, 255, 255, 0
