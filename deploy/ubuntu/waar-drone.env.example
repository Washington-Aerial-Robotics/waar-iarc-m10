# Copy to /etc/waar-drone/<linux-user>.env, make it root-owned/group-readable
# mode 0640,
# replace every REPLACE_* value, and run preflight.sh before enabling a service.

# Absolute path to this exact, tested repository checkout on the drone.
REPO_DIR=/opt/waar/REPLACE_WITH_REPOSITORY_DIRECTORY
ROS_DISTRO=humble
ROS_DOMAIN_ID=27
DRONE_ID=d1

# Safety defaults. The service wrapper rejects AUTO_ARM=true. Set DRY_RUN=false
# only after props-off HIL passes and set the explicit acknowledgement below.
DRY_RUN=true
AUTO_ARM=false
HARDWARE_ENABLE_ACK=disabled

# These values must match the firmware in this branch. The ESP32 currently uses
# a single TCP client, so do not run a second bridge or TCP probe concurrently.
ESP32_HOST=192.168.1.240
ESP32_PORT=70
TRANSPORT=tcp
SENDER_ID=P
ESP32_DEVICE_ID=U
# TCP is mandatory for this deployment; keep the alternate bridge serial path
# empty.
BRIDGE_SERIAL_PORT=
BRIDGE_SERIAL_BAUD=115200

# Use a stable /dev/v4l/by-id path discovered with `v4l2-ctl --list-devices`.
# Do not leave this as a /dev/videoN guess for flight.
VIDEO_DEVICE=/dev/v4l/by-id/REPLACE_WITH_STEREO_CAMERA
IMAGE_WIDTH=2560
IMAGE_HEIGHT=960
FRAMERATE=10.0

# The SLAM package's legacy CSV-over-serial bridge is disabled. Keep its sensor
# serial path empty unless a separate, documented device really is required.
SENSOR_SERIAL_PORT=
SENSOR_SERIAL_BAUD=115200

# The unified launch always starts SLAM and the one-drone MAS nodes. Perception
# can be disabled only for a staged camera-independent bridge test.
ENABLE_PERCEPTION=true
# Measure the black square itself (not white border or printed page) with a
# traceable ruler/caliper. The wrapper rejects this placeholder.
APRILTAG_SIZE_M=REPLACE_WITH_MEASURED_BLACK_SQUARE_METERS

# Frames used by the physical stack.
MAP_FRAME=map
ODOM_FRAME=odom
BASE_FRAME=base_link
ARENA_WIDTH_M=91.44
ARENA_HEIGHT_M=24.38
# Set true only after the signed arena-frame survey proves map alignment. The
# wrapper also requires the survey record ID below.
ARENA_MAP_ALIGNED=false

# Survey/configuration release identifiers. These are documentation gates: set
# them to the signed calibration/survey records used for this exact aircraft.
ARENA_FRAME_SURVEY_ID=REPLACE_WITH_ARENA_FRAME_SURVEY_RECORD
CAMERA_EXTRINSICS_ID=REPLACE_WITH_CAMERA_EXTRINSICS_RECORD
STEREO_CALIBRATION_ID=REPLACE_WITH_STEREO_CALIBRATION_RECORD
YAW_ALIGNMENT_ID=REPLACE_WITH_YAW_ALIGNMENT_RECORD

# Firmware currently marks its battery estimate invalid (the legacy value was
# hardcoded to 100). These records and a conservative, reviewed limit are
# mandatory until real battery sensing is implemented and tested.
BATTERY_SAFETY_ID=REPLACE_WITH_INDEPENDENT_BATTERY_MONITOR_RECORD
MAX_FLIGHT_TIME_S=REPLACE_WITH_CONSERVATIVE_TESTED_LIMIT
# Current firmware has BATTERY_VALID=false. The wrapper permits false only when
# the independent battery record and flight-time limit above are configured.
REQUIRE_BATTERY_VALID=true

# P arming is blocked until runtime control calibration is valid. This names
# the aircraft-specific calibration record; no default thrust value is safe.
CONTROL_CALIBRATION_ID=REPLACE_WITH_AIRCRAFT_CONTROL_CALIBRATION_RECORD
