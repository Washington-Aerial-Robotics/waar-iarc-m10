# Dedicated lab router, with DHCP reservations for PC/Pi.
# Install as /etc/waar-single-drone.env. No SDK or ROS2 is needed on the Pi.
# monitor only requests state; change to bridge after the prop-off checks.
WAAR_MODE=monitor
VICON_RELAY_IP=192.168.0.10
DRONE_IP=192.168.0.240
DRONE_ID=U
UDP_BIND=0.0.0.0
UDP_PORT=5100
SEND_RATE=100
STATE_RATE=10
YAW_OFFSET_DEG=0
